{
  "name": "scripture-scroller",
  "version": "0.2.0",
  "description": "Lightweight browser-based presentation tool for displaying Bible passages with smooth scrolling",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build-deck": "node scripts/build-deck.js",
    "build-reference": "node scripts/build-deck.js examples/2026-06-28.deck.json",
    "optimize-templates": "bash scripts/optimize-templates.sh",
    "sync-templates": "bash scripts/sync-templates.sh",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:update": "UPDATE_GOLDEN=1 node --test \"tests/**/*.test.js\" && npm run build-reference"
  },
  "keywords": [
    "bible",
    "presentation",
    "worship",
    "scripture"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2"
  }
}

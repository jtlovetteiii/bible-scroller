# Copy to .env (gitignored) and fill in.

# --- Claude Agent SDK auth ---
# Generate with: claude setup-token   (long-lived, ~1yr, bills the subscription)
CLAUDE_CODE_OAUTH_TOKEN=

# FOOT-GUN: if ANTHROPIC_API_KEY is set anywhere in the service's environment it
# SILENTLY WINS over the OAuth token above and bills a pay-per-token API account
# instead of the subscription. Leave it unset. config.assert_subscription_auth()
# fails loudly if it is present.

# Model the agent runs on. Sonnet keeps cost down (the whole point of the epic).
AGENT_MODEL=claude-sonnet-5

# --- Email gate (bs-tiz.1) ---
# Subject-line regex deciding what is "for the agent". Case-insensitive.
AGENT_SUBJECT_PATTERN=^\s*(re:\s*)*\s*(AI:|Calvary AI)
AGENT_POLL_INTERVAL=60
AGENT_LOOKBACK_DAYS=7

# --- Deck publishing (bs-tiz.6, bs-tiz.10) ---
# Public origin the minister's browser hits: the deck HTML and the template
# images it references both hang off this. Point it at the deck bucket's website
# endpoint, or at a CloudFront/custom domain once one exists.
# NOTE: http:// for now — S3 website endpoints do not support https (bs-a4a).
DECK_BASE_URL=http://cbc-wilm-agent-public.s3-website-us-east-1.amazonaws.com
# Bucket the publish tool uploads to. Separate from DECK_BASE_URL because the two
# stop matching the moment a CDN or custom domain fronts the bucket.
DECK_BUCKET=cbc-wilm-agent-public
# Key prefix for published decks. Treat as PERMANENT: emailed links live in the
# mailbox forever, so changing this rots every link already sent.
DECK_PREFIX=decks

# --- AWS credentials for the publish tool ---
# NOT set here. The agent host supplies them via its systemd EnvironmentFile
# (0600, root-owned) — never a .env in the repo. The IAM user is cbc-wilm-agent
# (infra/iam.tf); its access key is created by hand in the console and is
# deliberately absent from Terraform state.
# FOOT-GUN, same family as ANTHROPIC_API_KEY above: the AWS SDK has its own
# credential chain in which env vars BEAT ~/.aws/credentials, so a stray
# AWS_PROFILE or key pair in the service environment silently publishes to
# whatever account those point at.

# Optional, dev only: overrides the background asset root for a manual
# `node scripts/build-deck.js` run (bs-tiz.9). The publish tool does NOT read
# this — it composes the asset base from DECK_BASE_URL and passes it explicitly.
# DECK_ASSET_BASE=
